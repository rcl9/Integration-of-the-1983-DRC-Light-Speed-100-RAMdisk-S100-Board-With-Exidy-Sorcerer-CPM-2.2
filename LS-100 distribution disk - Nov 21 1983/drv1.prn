

                ;PROGRAM DRV1.ASM
                ;LS-100 DRIVER PROGRAM 
                ;BY RVA 
                ;TO BE RELOCATED BELOW CCP
                ;LAST CHANGE
                ;6/23/1983
                ;COPYRIGHT 1983
                ;DIGITAL RESEARCH COMPUTERS
                ;ALL RIGHTS RESERVED
                ;
                ;
 FFFF =         TRUE	EQU	0FFFFH		;VALUE FOR TRUE
 0000 =         FALSE	EQU	NOT TRUE	;VALUE FOR FALSE
                ;
 0000 =         STND	EQU	FALSE		;SET TO TRUE FOR STANDARD CP/M
 FFFF =         OFST	EQU	TRUE		;SET TO TRUE FOR NON-STANDARD CP/M
                ;
                	IF	STND
                MSIZE	EQU	60		;CP/M SIZE IN KILOBYTES
                CBASE	EQU	(MSIZE-20)*1024	;BIAS
                CPMB	EQU	CBASE+3400H	;BASE ADDRESS OF CCP
                BIOS	EQU	CBASE+4A00H	;BIOS ADDRESS
                CONOUT	EQU	BIOS+12		;BIOS CONSOLE OUTPUT 	
                BDOS	EQU	CBASE+3C06H	;BDOS ENTRY
                	ENDIF
                ;
                	IF	OFST
 C300 =         BIOS	EQU	0C300H		;ADDRESS OF BIOS
 B506 =         BDOS	EQU	0B506H		;ADDRESS OF BDOS
 AD00 =         CPMB	EQU	BDOS-806H	;ADDRESS OF CCP
                	ENDIF
                ;
 C30C =         CONOUT	EQU	BIOS+12		;BIOS CONSOLE OUTPUT
 0004 =         DRVID	EQU	04		;ACTIVE DRIVE # (E)
 0041 =         DRVLD	EQU	41H		;DRIVER ID BYTE
                ;
                ;LS-100 PORT ADDRESS ASSIGMENT
                ;
 0000 =         PBASE	EQU	000H		;BASE PORT ADDRESS
 0000 =         REG0	EQU	PBASE		;DATA TRANSFER PORT
 0001 =         REG1	EQU	PBASE+1		;MSB ADDRESS LATCH
 0002 =         REG2	EQU	PBASE+2		;LSB ADDRESS LATCH
 0003 =         REG3	EQU	PBASE+3		;BYTE LOCATION ADDRESS COUNTERS
 0080 =         NBYTES	EQU	128		;BYTES/SECTOR
                ;
                ;START OF DRIVER
                ;
 A900           	ORG	CPMB-1024	;ALLLOW 1K FOR DRIVER
 A900 41        	DB	DRVLD		;DRIVER ID BYTE
 A901 00        	DB	0
 A902 00000000  	DW	0,0		;6 BYTE OFFSET
 A906 C306B5    BDOS1:	JMP	BDOS		;LINK TO BDOS ENTRY
                ;
                ;DRIVER BIOS JUMP TABLE
                ;
 A909 C364A9    WBOOT1:	JMP	WBOOT		;WARM BOOT
 A90C C378A9    HOME1:	JMP	HOME		;HOME
 A90F C383A9    SLDSK1:	JMP	SLDSK		;SELECT DISK
 A912 C391A9    STRK1:	JMP	STRK		;SET TRACK
 A915 C39CA9    SSEC1:	JMP	SSEC		;SET SECTOR
 A918 C3A7A9    SDMA1:	JMP	SDMA		;SET DMA ADDRESS
 A91B C3B8A9    RDE1:	JMP	RDE		;READ SECTOR
 A91E C328AA    WRE1:	JMP	WRE		;WRITE SECTOR
 A921 C33FA9    LSTS1:	JMP	LSTS2		;LIST STATUS
 A924 C3AFA9    SCTRL1: JMP	SCTRL		;SECTOR TRANSLATOR
                ;
                ;RELOCATED CP/M BIOS JUMP TABLE
                ;
 A927           WBOOT2:	DS	3		;WARM BOOT
 A92A           HOME2:	DS	3		;HOME
 A92D           SLDSK2:	DS	3		;SELECT DISK
 A930           STRK2:	DS	3		;SET TRACK
 A933           SSEC2:	DS	3		;SET SECTOR
 A936           SDMA2:	DS	3		;SET DMA ADDRESS
 A939           RDE2:	DS	3		;READ SECTOR
 A93C           WRE2:	DS	3		;WRITE SECTOR
 A93F           LSTS2:	DS	3		;LIST STATUS
 A942           SCTRL2: DS	3		;SECTOR TRANSLATOR
                ;
                ;
                ;
 A945 00000000  DPE0:	DW	XLT0,0000H	;TRANSLATE TABLE
 A949 00000000  	DW	0000H,0000H	;SCRATCH AREA
 A94D B9AA55A9  	DW	DIRBUF,DPB0	;DIR.BUF./PARM. BLOCK
 A951 79AB39AB  	DW	CSV0,ALV0	;CHECK ALLOC. VECTORS
                ;
                ;THE FOLLOWING PARAMETERS ARE FOR 1 MEMORY BOARD
                ;
 A955 =         DPB0:	EQU	$		;DISK PARM. BLOCK
 A955 1000      	DW	16		;SECTORS/TRACK
 A957 04        	DB	4		;BLOCK SHIFT
 A958 0F        	DB	15		;BLOCK MASK
 A959 01        	DB	1		;EXTNT MASK
 A95A FD00      	DW	253		;SIZE-1
 A95C 7F00      	DW	127		;MAX. DIR. ENTRYS
 A95E C0        	DB	192		;ALLOC0
 A95F 00        	DB	0		;ALLOC1
 A960 0000      	DW	0		;CHECK SIZE
 A962 0200      	DW	2		;OFFSET
 0000 =         XLT0:	EQU	0		;NOT REQUIRED
                ;
                ;DRIVER ROUTINES
                ;
 A964 318000    WBOOT:	LXI	SP,80H		;RESET STACK
 A967 2106A9    	LXI	H,BDOS1		;HL=BASE OF DRIVER
 A96A 220600    	SHLD	6		;REFLECT REDUCED SIZE
 A96D 24        	INR	H		;SKIP PAST DRIVER
 A96E 24        	INR	H		;
 A96F 24        	INR	H		;
 A970 24        	INR	H		;HL=HL+1024
 A971 2E03      	MVI	L,3		;
 A973 3A0400    	LDA	4		;GET CURRENT DRIVE
 A976 4F        	MOV	C,A		;MOVE INTO C
 A977 E9        	PCHL			;LOG IN DRIVE (CCP+3)
                
                ;
                ;HOME ROUTINE
                ;
 A978 CD68AA    HOME:	CALL	CHK		;CHECK FOR LS-100
 A97B C22AA9    	JNZ	HOME2		;IF NOT JUMP TO BIOS
 A97E AF        	XRA	A		;CLEAR A
 A97F 32B5AA    	STA	TRK		;SET TO TRACK 0
 A982 C9        	RET
                ;
                ;SELECT DISK ROUTINE
                ;
 A983 79        SLDSK:	MOV	A,C		;GET DRIVE #
 A984 32B4AA    	STA	UNIT		;SAVE IT
 A987 3E04      	MVI	A,DRVID		;GET ACTIVE DRIVE #
 A989 B9        	CMP	C		;CHECK FOR LS-100
 A98A C22DA9    	JNZ	SLDSK2		;IF NOT JUMP TO BIOS
 A98D 2145A9    	LXI	H,DPE0		;HL=DISK PARM. BLOCK
 A990 C9        	RET
                ;
                ;SET TRACK ROUTINE
                ;
 A991 CD68AA    STRK:	CALL	CHK		;CHECK FOR LS-100
 A994 C230A9    	JNZ	STRK2		;IF NOT JUMP TO BIOS
 A997 79        	MOV	A,C		;GET TRACK #
 A998 32B5AA    	STA	TRK		;STORE IT
 A99B C9        	RET
                ;
                ;SET SECTOR ROUTINE
                ;
 A99C CD68AA    SSEC:	CALL	CHK		;CHECK FOR LS-100
 A99F C233A9    	JNZ	SSEC2		;IF NOT JUMP TO BIOS
 A9A2 79        	MOV	A,C		;GET SECTOR #
 A9A3 32B6AA    	STA	SEC		;STORE IT
 A9A6 C9        	RET
                ;
                ;SET UP DMA ADDRESS
                ;
 A9A7 60        SDMA:	MOV	H,B		;H=B
 A9A8 69        	MOV	L,C		;L=C
 A9A9 22B7AA    	SHLD	TADDR		;STORE IT
 A9AC C336A9    	JMP	SDMA2		;PASS PARM. TO BIOS
                ;
                ;LS-100 SECTOR TRANSLATE ROUTINE
                ;
 A9AF CD68AA    SCTRL:	CALL	CHK		;CHECK FOR LS-100
 A9B2 C242A9    	JNZ	SCTRL2		;IF NOT JUMP TO BIOS
 A9B5 60        	MOV	H,B		;NO TRANLASTION REQUIRED
 A9B6 69        	MOV	L,C		;SET HL=BC
 A9B7 C9        	RET
                ;
                ;LS-100 SECTOR READ ROUTINE
                ;
 A9B8 CD68AA    RDE:	CALL	CHK		;CHECK FOR LS-100
 A9BB C239A9    	JNZ	RDE2		;IF NOT JUMP TO BIOS
 A9BE CD43AA    	CALL	SETUP		;SET UP LS-100 REGS.
 A9C1 DB00      RDLP:	IN	REG0		;GET DATA FROM LS-100
 A9C3 77        	MOV	M,A		;STORE @ HL
 A9C4 83        	ADD	E		;COMPUTE CHECK SUM
 A9C5 5F        	MOV	E,A		;ACCUMULATE CHECK SUM IN E
 A9C6 23        	INX	H		;BUMP POINTER
 A9C7 05        	DCR	B		;DECREMENT BYTE COUNT
 A9C8 C2C1A9    	JNZ	RDLP		;LOOP UNTIL ZERO	
 A9CB CD55AA    	CALL	CALC		;SET ADDRESS OF CHECK SUM BYTE
 A9CE DB00      	IN	REG0		;GET CHECK SUM BYTE
 A9D0 93        	SUB	E		;CHECK FOR ERROR 
 A9D1 C8        	RZ			;RETURN IF NO ERROR 
                ;
                ;PROCESS CHECK SUM ERROR
                ;
 A9D2 3AB5AA    	LDA	TRK		;GET CURRENT TRACK #
 A9D5 CD10AA    	CALL	CNVHX		;CONVERT TO HEX ASCII
 A9D8 22A3AA    	SHLD	BDTRK		;PUT IN MESSAGE
 A9DB 3AB6AA    	LDA	SEC		;GET CURRENT SECTOR #
 A9DE CD10AA    	CALL	CNVHX		;CONVERT TO HEX ASCII
 A9E1 22AEAA    	SHLD	BDSCTR		;PUT IN MESSAGE
                ;
                ;FIND WHICH LS-100 BOARD THE ERROR OCCURED ON
                ;
 A9E4 0631      	MVI	B,'1'		;START WITH BOARD #1
 A9E6 3AB6AA    	LDA	SEC		;GET CURRENT SECTOR #
 A9E9 D608      FIND:	SUI	8		;SUB. OFFSET/BOARD
 A9EB DAF2A9    	JC	FOUND		;CHECK FOR OVERFLOW
 A9EE 04        	INR	B		;BUMP BOARD COUNTER
 A9EF C3E9A9    	JMP	FIND		;KEEP LOOKING
 A9F2 78        FOUND:	MOV	A,B		;GET BOARD #
 A9F3 3297AA    	STA	BDBRD		;PUT IN MESSAGE
                ;
                ;PRINT ERROR MESSAGE ON CONSOLE
                ;
 A9F6 216EAA    	LXI	H,MESG1		;HL @ ERROR MESSAGE
 A9F9 7E        SMESG:	MOV	A,M		;GET DATA
 A9FA B7        	ORA	A		;CHECK FOR END OF MESSAGE
 A9FB CA08AA    	JZ	EXIT		;EXIT IF SO
 A9FE 4F        	MOV	C,A		;SETUP FOR BIOS CALL
 A9FF E5        	PUSH	H		;SAVE POINTER
 AA00 CD0CC3    	CALL	CONOUT		;OUTPUT BYTE
 AA03 E1        	POP	H		;RESTORE POINTER
 AA04 23        	INX	H		;BUMP POINTER
 AA05 C3F9A9    	JMP	SMESG		;LOOP UNTIL END OF MESSAGE
                ;
                ;SET DEFAULT DRIVE TO A AND ABORT
                ;
 AA08 AF        EXIT:	XRA	A		;CLEAR A
 AA09 4F        	MOV	C,A		;SET TO DRIVE A
 AA0A 320400    	STA	4		;SET TO DRIVE A
 AA0D C30000    	JMP 	0		;RETURN TO CP/M
                ;
                ;CONVERT HEX BYTE IN A. RETURN TWO HEX ASCII CHARS. IN HL
                ;
 AA10 F5        CNVHX:	PUSH	PSW
 AA11 0F        	RRC
 AA12 0F        	RRC
 AA13 0F        	RRC
 AA14 0F        	RRC
 AA15 CD1FAA    	CALL	HASCI
 AA18 6F        	MOV	L,A
 AA19 F1        	POP	PSW
 AA1A CD1FAA    	CALL	HASCI
 AA1D 67        	MOV	H,A
 AA1E C9        	RET
 AA1F E60F      HASCI:	ANI	0FH
 AA21 C690      	ADI	90H
 AA23 27        	DAA
 AA24 CE40      	ACI	40H
 AA26 27        	DAA
 AA27 C9        	RET			
                ;
                ;LS-100 SECTOR WRITE ROUTINE
                ; 
 AA28 CD68AA    WRE:	CALL	CHK		;CHECK FOR LS-100
 AA2B C23CA9    	JNZ	WRE2		;IF NOT JUMP TO BIOS
 AA2E CD43AA    	CALL	SETUP		;SET UP LS-100 REGS.
 AA31 7E        WRLP:	MOV	A,M		;GET DATA FROM MEMY. @ HL
 AA32 D300      	OUT	REG0		;STORE DATA
 AA34 83        	ADD	E		;COMPUTE CHECK SUM
 AA35 5F        	MOV	E,A		;ACCUMULATE CHECK SUM IN E
 AA36 23        	INX	H		;BUMP POINTER
 AA37 05        	DCR	B		;DECREMENT BYTE COUNT
 AA38 C231AA    	JNZ	WRLP		;LOOP UNTIL ZERO
 AA3B CD55AA    	CALL	CALC		;SET ADDRESS OF CHECK SUM BYTE
 AA3E 7B        	MOV	A,E		;GET CHECK SUM BYTE
 AA3F D300      	OUT	REG0		;STORE CHECK SUM BYTE
 AA41 AF        	XRA	A		;NORMAL RETURN
 AA42 C9        	RET
                ;
                ;SETUP LS-100 REGS. BASED ON CURRENT TRACK & SECTOR
                ;
 AA43 3AB5AA    SETUP:	LDA	TRK		;GET CURRENT TRACK #
 AA46 D302      	OUT	REG2		;SET LSB ADDRESS LATCH
 AA48 3AB6AA    	LDA	SEC		;GET CURRENT SECTOR #
 AA4B D301      	OUT 	REG1		;SET MSB ADDRESS LATCH
 AA4D 2AB7AA    	LHLD	TADDR		;HL=DMA POINTER
 AA50 0680      	MVI	B,NBYTES	;B=BYTES/SECTOR
 AA52 1E00      	MVI	E,0		;CLEAR CHECK SUM BYTE
 AA54 C9        	RET
                ;
                ;COMPUTE ADDRESS FOR CHECK SUM BYTE & SET UP LS-100 REGS.
                ;
 AA55 21B5AA    CALC:	LXI	H,TRK		;HL @ TRACK #
 AA58 AF        	XRA	A		;CLEAR A/CARRY FLAG
 AA59 D302      	OUT	REG2		;SET TO TRACK 0
 AA5B 7E        	MOV	A,M		;GET CURRENT TRACK
 AA5C 07        	RLC			;MOD 128
 AA5D D264AA    	JNC	SKP1		;JUMP IF <128
 AA60 3E01      	MVI	A,1		;SET TO TRACK 1
 AA62 D302      	OUT	REG2		;UPDATE LSB ADDRESS LATCH
 AA64 7E        SKP1:	MOV	A,M		;RESTORE TRACK #
 AA65 D303      	OUT	REG3		;SET BYTE LOCATION ADDRESS COUNTERS
 AA67 C9        	RET
                ;
                ;CHECK THE CURRENT DRIVE BYTE FOR LS-100
                ;
 AA68 3AB4AA    CHK:	LDA	UNIT		;GET DRIVE #
 AA6B FE04      	CPI	DRVID		;Z=0 DRIVE ACTIVE/Z=1 DRIVE NOT ACTIVE
 AA6D C9        	RET
                
                ;
                ;MESSAGE AREA
                ;
 AA6E 0A0D      MESG1:	DW	0D0AH
 AA70 436865636B	DB	'Checksum error occured on LS-100 board '
 AA97 00        BDBRD:	DB	0
 AA98 0A0D      	DW	0D0AH
 AA9A 6174207472	DB	'at track '
 AAA3 0000      BDTRK:	DW	0
 AAA5 48        	DB	'H'
 AAA6 2073656374	DB	' sector '
 AAAE 0000      BDSCTR: DW	0
 AAB0 48        	DB	'H'
 AAB1 0A0D      	DW	0D0AH
 AAB3 00        	DB	0
                ;
                ;
                ;LOCAL STORAGE MUST BE IN RAM
                ;
 AAB4           UNIT:	DS	1		;CURRENT DRIVE
 AAB5           TRK:	DS	1		;CURRENT TRACK
 AAB6           SEC:	DS	1		;CURRENT SECTOR
 AAB7           TADDR:	DS	2		;TRANSFER ADDRESS
 AAB9           DIRBUF:	DS	128		;DIRECTORY ACCESS BUFFER
 AB39           ALV0:	DS	64		;ALLOCATION VECTOR
 AB79 00        CSV0:	DB	0		;CHECK SUM VECTOR
 AB7A           	END
